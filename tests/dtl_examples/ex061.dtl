<!-- DTL Guide example (z/OS 2.4 ISPF DTL Guide, f54dt00_v2r4.pdf),
     extracted verbatim. Used to test our DTL subset against the real
     reference; see test_dtl_examples.py. -->
<!doctype dm system>
<panel name=ulists width=42>Nested Unordered Lists
  <area>
    <info width=40>
      <ul>
        <li>First level, first item
        <li>First level, second item
         <ul>
           <li>Second level, first item
           <li>Second level, second item
             <ul>
               <li>Third level, only item
             </ul>
         </ul>
        <li>Back to the first level
      </ul>
    </info>
  </area>
</panel>

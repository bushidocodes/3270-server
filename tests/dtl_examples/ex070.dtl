<!-- DTL Guide example (z/OS 2.4 ISPF DTL Guide, f54dt00_v2r4.pdf),
     extracted verbatim. Used to test our DTL subset against the real
     reference; see test_dtl_examples.py. -->
<!doctype dm system>
<panel name=payment width=52>Payment Procedures
  <area>
    <info width=50>
      <h1>Methods of Payment
      <dl tsize=9 break=all>
        <dt>Cash
        <dd>Of course, we always accept cash!
        <dt>Charge
        <dd>Your charge card is welcome here!
        We accept the following charge cards:
          <ul compact>
            <li>BigCharge
            <li>MoneyCard
            <li>Plastic Express
          </ul>
        <dt>Personal check
        <dd>We gladly welcome your personal check,
        with the proper identification.
      </dl>
    </info>
  </area>
</panel>

<!DOCTYPE DM SYSTEM>
<!-- ISPF z/OS System Programmer Applications (a demo selection sub-menu). Its choices are
     authentic ISPF sub-functions; each leaf reports back via &SELMSG
     (not yet implemented). Driven by server._show_submenu; PF3 returns. -->
<panel name="zsystem" help="ispfhelp">z/OS System Programmer Applications
  <info row="0" col="0" intensity="high">--------------------- z/OS System Programmer Applications ---------------------</info>

  <cmdarea row="2" col="1" fldcol="13" entwidth="6" cursor="yes">Option ===></cmdarea>

  <selfld row="4" numcol="1" namecol="4" desccol="21" numwidth="2" numintensity="high">
    <choice num="1" name="  ISMF            ">  Interactive Storage Management Facility</choice>
    <choice num="2" name="  SDSF            ">  System Display and Search Facility</choice>
    <choice num="3" name="  RMF             ">  Resource Measurement Facility</choice>
    <choice num="4" name="  HCD             ">  Hardware Configuration Definition</choice>
    <choice num="5" name="  Console         ">  Extended MCS operator console</choice>
  </selfld>

  <info row="20" col="1" intensity="high">&SELMSG</info>
  <info row="22" col="1">Enter an option, or PF3 to return to the Primary Option Menu.</info>
  <info row="23" col="0" intensity="high" fill="-" width="79"/>

  <keyl name="ZSYSKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>

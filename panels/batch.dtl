<!DOCTYPE DM SYSTEM>
<!-- ISPF Batch Selection Panel (a selection sub-menu). Each leaf reports back via &SELMSG
     (not yet implemented). Driven by server._show_submenu; PF3 returns. Auto-flow
     (ISPDTLC-idiomatic): <selfld type=menu>, auto-numbered, no row/col or grid;
     the keyword+description are folded into the padded choice text. -->
<panel name="batch" help="ispfhelp">Batch Selection Panel
  <cmdarea cursor="yes">Option ===></cmdarea>

  <selfld type="menu">
    <choice>Assembler        Assemble a source program as a batch job</choice>
    <choice>COBOL            Compile a COBOL source program (batch)</choice>
    <choice>PL/I             Compile a PL/I source program (batch)</choice>
    <choice>Fortran          Compile a VS FORTRAN source program (batch)</choice>
    <choice>C/C++            Compile a C or C++ source program (batch)</choice>
  </selfld>

  <info><hp>&SELMSG</hp></info>
  <botinst>Enter an option, or PF3 to return to the Primary Option Menu.</botinst>

  <keyl name="BATCHKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>

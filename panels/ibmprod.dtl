<!DOCTYPE DM SYSTEM>
<!-- ISPF IBM Products Panel (a selection sub-menu). Each leaf reports back via &SELMSG
     (not yet implemented). Driven by server._show_submenu; PF3 returns. Auto-flow
     (ISPDTLC-idiomatic): <selfld type=menu>, auto-numbered, no row/col or grid;
     the keyword+description are folded into the padded choice text. -->
<panel name="ibmprod" help="ispfhelp" cursor="ZCMD">IBM Products Panel
  <cmdarea>Option ===></cmdarea>

  <selfld type="menu">
    <choice>ISMF             Interactive Storage Management Facility</choice>
    <choice>SDSF             System Display and Search Facility</choice>
    <choice>RACF             Resource Access Control Facility</choice>
    <choice>HCD              Hardware Configuration Definition</choice>
    <choice>DFSORT           Sort, merge, copy, and report utility</choice>
  </selfld>

  <info><hp>&SELMSG</hp></info>
  <botinst>Enter an option, or PF3 to return to the Primary Option Menu.</botinst>

  <keyl name="IBMPKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>

<!DOCTYPE DM SYSTEM>
<!-- ISPF z/OS User Applications (a selection sub-menu). Each leaf reports back via &SELMSG
     (not yet implemented). Driven by server._show_submenu; PF3 returns. Auto-flow
     (ISPDTLC-idiomatic): <selfld type=menu>, auto-numbered, no row/col or grid;
     the keyword+description are folded into the padded choice text. -->
<panel name="zuser" help="ispfhelp">z/OS User Applications
  <cmdarea cursor="yes">Option ===></cmdarea>

  <selfld type="menu">
    <choice>Info Center      Information Center Facility</choice>
    <choice>TSO/E            Time Sharing Option / Extensions</choice>
    <choice>Utilities        Programmer's workbench utilities</choice>
    <choice>REXX/CLIST       Run a REXX exec or CLIST</choice>
  </selfld>

  <info intensity="high">&SELMSG</info>
  <botinst>Enter an option, or PF3 to return to the Primary Option Menu.</botinst>

  <keyl name="ZUSRKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>

<!DOCTYPE DM SYSTEM>
<!-- ISPF Utility Selection Panel (option 3) -- a nested selection menu.
     Same shape as the Primary Option Menu: an Option ===> command line
     (<cmdarea>, ZCMD) and a <selfld type=menu> of choices. The server reads the
     option with Screen.command_value() and validates it against Screen.selections;
     an unimplemented leaf reports back via &SELMSG. PF3 returns to the menu.
     Auto-flow (ISPDTLC-idiomatic): no row/col and no manual number/keyword grid;
     the menu auto-numbers, SELCHAR gives Outlist its 8, and the keyword+description
     are folded into the choice text (padded so the descriptions line up). -->
<panel name="utility" help="ispfhelp" cursor="ZCMD">Utility Selection Panel
  <cmdarea>Option ===></cmdarea>

  <selfld type="menu">
    <choice>Library          Compress or print data set; rename/delete members</choice>
    <choice>Data Set         Allocate, rename, delete, catalog, or display a data set</choice>
    <choice>Move/Copy        Move or copy members or data sets</choice>
    <choice>Dslist           Print or display a list of data set names</choice>
    <choice>Reset            Reset statistics for members of an ISPF library</choice>
    <choice selchar="8">Outlist          Display, delete, or print held job output</choice>
  </selfld>

  <info><hp>&SELMSG</hp></info>
  <botinst>Enter an option, or PF3 to return to the Primary Option Menu.</botinst>

  <keyl name="UTILKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>

  <!-- )PROC: this sub-menu's own option routing (see #55). Only Library (1) is
       implemented; the rest report "not yet implemented" via &SELMSG. -->
  <source type="proc">
    &ZSEL = TRANS( TRUNC(&ZCMD,'.')
        1,'PGM(memberlist)'
        *,'?' )
  </source>
</panel>

<!DOCTYPE DM SYSTEM>
<!-- ISPF Foreground Selection Panel (a selection sub-menu). Each leaf reports back via &SELMSG
     (not yet implemented). Driven by server._show_submenu; PF3 returns. Auto-flow
     (ISPDTLC-idiomatic): <selfld type=menu>, auto-numbered, no row/col or grid;
     the keyword+description are folded into the padded choice text. -->
<panel name="foreground" help="ispfhelp" cursor="ZCMD">Foreground Selection Panel
  <cmdarea>Option ===></cmdarea>

  <selfld type="menu">
    <choice>Assembler        Assemble a source program in the foreground</choice>
    <choice>COBOL            Compile a COBOL source program</choice>
    <choice>PL/I             Compile a PL/I source program</choice>
    <choice>Fortran          Compile a VS FORTRAN source program</choice>
    <choice>C/C++            Compile a C or C++ source program</choice>
    <choice>Member list      Display a member parts list</choice>
  </selfld>

  <info><hp>&SELMSG</hp></info>
  <botinst>Enter an option, or PF3 to return to the Primary Option Menu.</botinst>

  <keyl name="FGNDKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>

<!DOCTYPE DM SYSTEM>
<!-- ISPF Object/Action Workplace (option 11). An informational leaf panel:
     it describes the Workplace and lists the object types it works with.
     Shown via _show_overlay; PF3 returns to the Primary Option Menu.
     Auto-flow (ISPDTLC-idiomatic): no row/col; the title centres itself and the
     conversion utility spaces the paragraphs. -->
<panel name="workplace" help="ispfhelp">ISPF Object/Action Workplace
  <topinst>The Workplace lets you act on objects by selecting them and choosing
           an action, rather than navigating the option menus.</topinst>

  <info>
    <p intensity="high">Objects you can work with:</p>
    <ul>
      <li>Data sets and libraries</li>
      <li>Library members</li>
      <li>Workstation files</li>
      <li>Commands and command tables</li>
    </ul>

    <p>Select an object, then choose an action from the action bar.
       (Object selection is not implemented in this demo.)</p>
  </info>

  <botinst>Enter PF3 to return to the Primary Option Menu.</botinst>

  <keyl name="WPKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>

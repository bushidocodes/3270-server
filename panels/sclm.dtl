<!DOCTYPE DM SYSTEM>
<!-- ISPF SCLM Main Menu (a selection sub-menu). Each leaf reports back via &SELMSG
     (not yet implemented). Driven by server._show_submenu; PF3 returns. Auto-flow
     (ISPDTLC-idiomatic): <selfld type=menu>, auto-numbered, no row/col or grid;
     the keyword+description are folded into the padded choice text. -->
<panel name="sclm" help="ispfhelp" cursor="ZCMD">SCLM Main Menu
  <cmdarea>Option ===></cmdarea>

  <selfld type="menu">
    <choice>View             View an SCLM-controlled member</choice>
    <choice>Edit             Edit an SCLM-controlled member</choice>
    <choice>Utilities        SCLM library and member utilities</choice>
    <choice>Build            Build (compile/link) a member</choice>
    <choice>Promote          Promote a member up the hierarchy</choice>
  </selfld>

  <info><hp>&SELMSG</hp></info>
  <botinst>Enter an option, or PF3 to return to the Primary Option Menu.</botinst>

  <keyl name="SCLMKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>

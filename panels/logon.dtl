<!DOCTYPE DM SYSTEM>
<!-- z/OS V2R5.0 TSO/E LOGON panel, in standard auto-flow DTL. The two-column
     form (LOGON parameters | RACF parameters) is a <region dir=horiz> of two
     WIDTH-capped <region>s, so each column's rule spans its own width and the
     RACF column sits to the right without absolute positioning. The wide
     Command / PDS-E Dsname fields flow full width below the two columns.
     Cursor starts in Userid via <panel cursor=userid>; SIZE/PERFORM are typed
     via <varclass>. The transient logon error message is injected at runtime by
     server.send_tso_logon, not here. -->
<panel name="tsologon" cursor="userid" help="tsohelp">z/OS V2R5.0 TSO/E LOGON
  <!-- Typed variables: SIZE and PERFORM are numeric. Declaring them via a
       <varclass> lets their <dtafld>s omit numeric="yes" and inherit the type.
       SIZE additionally carries a range check; the server rejects out-of-range
       input with message TSO001 before processing the logon. -->
  <varclass name="NUMFLD" type="numeric"/>
  <varclass name="SIZEFLD" type="numeric">
    <checkl msg="TSO001">
      <checki type="range">0 32768</checki>
    </checkl>
  </varclass>
  <varlist>
    <vardcl name="size"    varclass="SIZEFLD"/>
    <vardcl name="perform" varclass="NUMFLD"/>
  </varlist>

  <!-- The two-column parameter form. Each <region width=n> fixes its column so
       the divider rule spans that column and the RACF column starts to its
       right. COLOR=WHITE colours the entry field (mono renders unchanged). -->
  <region dir="horiz">
    <region width="39">
      <topinst>Enter LOGON parameters below:</topinst>
      <divider/>
      <dtafld datavar="userid"    entwidth="8" color="white">Userid   ===></dtafld>
      <dtafld datavar="password"  entwidth="8" display="no">Password ===></dtafld>
      <dtafld datavar="procedure" entwidth="8" init="IKJACCNT" color="white">Procedure===></dtafld>
      <dtafld datavar="size"      entwidth="5" init="00150" color="white" help="sizehelp">Size     ===></dtafld>
    </region>
    <region width="37">
      <topinst>RACF LOGON parameters:</topinst>
      <divider/>
      <!-- The RACF column starts two rows lower so Acct/Perform align with
           Procedure/Size, matching the real TSO screen. It also keeps Userid
           and Password adjacent in buffer order, so Tab moves Userid -> Password
           (nothing from the right column sits between them). -->
      <divider type="blank"/>
      <divider type="blank"/>
      <dtafld datavar="acct"    entwidth="8" color="white">Acct Nmbr    ===></dtafld>
      <dtafld datavar="perform" entwidth="8" color="white">Perform      ===></dtafld>
      <info>Mail      ===> Yes</info>
      <info>Reconnect ===> Auto</info>
      <info>OIDcard   ===> None</info>
    </region>
  </region>

  <dtafld datavar="command" entwidth="62" color="white">Command  ===></dtafld>
  <dtafld datavar="dsname"  entwidth="59" color="white">PDS/E Dsname ===></dtafld>

  <info><hp>*** Authorized users only. Unauthorized access is prohibited. ***</hp></info>
  <pnlinst>Press ENTER to logon to TSO/E</pnlinst>
  <info>PF1=HELP   PF3=LOGOFF</info>
  <info>ENTER AN END COMMAND TO LOGOFF</info>

  <!-- Keylist: PF3/PF15 leave the panel (logoff). Metadata only -- the visible
       "PF1=HELP PF3=LOGOFF" line above is the displayed function-key area. -->
  <keyl name="TSOLOGON">
    <keyi key="PF1"  cmd="HELP">Help</keyi>
    <keyi key="PF3"  cmd="EXIT">Logoff</keyi>
    <keyi key="PF15" cmd="EXIT">Logoff</keyi>
  </keyl>
</panel>

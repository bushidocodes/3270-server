<!DOCTYPE DM SYSTEM>
<!-- ISPF Library Member List (Utilities -> 1, Library). A real leaf: the
     <lstfld> table is populated at runtime from the actual panel library
     (server._library_members lists panels/*.dtl as ISPPLIB members). Read-only
     (usage=out). Point-and-shoot: server._show_member_list maps the cursor row
     to a member so Enter browses it. PF3 returns to the Utility panel. -->
<panel name="memlist" title="Library - Member List" help="ispfhelp">
  <info row="0" col="0" intens="high">--------------------------- ISPF.ISPPLIB - Member List -------------------------</info>
  <topinst row="2" col="1">Put the cursor on a member and press Enter to browse it; PF3 returns.</topinst>

  <area row="4" col="2">
    <lstfld>
      <lstgrp headline="yes">Members
        <lstcol datavar="mname" usage="out" colwidth="10">Name
        <lstcol datavar="mtype" usage="out" colwidth="11">Type
        <lstcol datavar="mdesc" usage="out" colwidth="32">Description
      </lstgrp>
    </lstfld>
  </area>
  <!-- The footer line (&MEMFOOT) and the rule below it are placed by the server
       (server._show_member_list) on the last two rows of whatever screen we
       render on, so a taller alternate screen lists more members per page. -->

  <keyl name="MEMKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>

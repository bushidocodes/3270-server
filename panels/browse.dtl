<!DOCTYPE DM SYSTEM>
<!-- ISPF Browse panel. A header frame only: the title (&BRTITLE, e.g.
     "BROWSE  ISPF.ISPPLIB(LOGON)  Line 00000001") at row 0. The server
     (server._show_browse) injects the member's source lines below it and the
     footer rule on the last row, sized to the terminal's screen (a taller/wider
     alternate screen shows more lines), and pages them with PF7/PF8; PF3 exits
     back to the entry panel. -->
<panel name="browse" title="Browse" help="ispfhelp">
  <info row="0" col="0" intens="high">&BRTITLE</info>

  <keyl name="BRKEYS">
    <keyi key="PF3" cmd="EXIT">Exit</keyi>
    <keyi key="PF15" cmd="EXIT">Exit</keyi>
  </keyl>
</panel>

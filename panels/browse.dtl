<!DOCTYPE DM SYSTEM>
<!-- ISPF Browse panel. A frame only: the header title (&BRTITLE, e.g.
     "BROWSE  ISPF.ISPPLIB(LOGON)  Line 00000001") and a footer rule. The
     server (server._show_browse) injects the member's source lines at rows
     1..N and pages them with PF7/PF8; PF3 exits back to the entry panel. -->
<panel name="browse" title="Browse" help="ispfhelp">
  <info row="0" col="0" intensity="high">&BRTITLE</info>
  <info row="23" col="0" intensity="high">&BRFOOT</info>

  <keyl name="BRKEYS">
    <keyi key="PF3" cmd="EXIT">Exit</keyi>
    <keyi key="PF15" cmd="EXIT">Exit</keyi>
  </keyl>
</panel>

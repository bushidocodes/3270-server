<!DOCTYPE DM SYSTEM>
<!-- ISPF Edit - Entry Panel (option 2). Like View, but opens the member in an
     EDIT frame. Editing is display-only in this demo; the server (_show_view
     with verb=EDIT) reads the `member` field and browses its source. An unknown
     member is reported via &VIEWMSG. PF3 returns to the menu.
     Auto-flow (ISPDTLC-idiomatic): no row/col/fldcol; the entry field follows
     its prompt and the cursor starts there via <panel cursor=member>. -->
<panel name="editentry" help="ispfhelp" cursor="member">Edit - Entry Panel
  <topinst>Enter the name of a panel library (ISPPLIB) member to edit.</topinst>

  <dtafld datavar="member" entwidth="8">Member name ===></dtafld>

  <info><hp>&VIEWMSG</hp></info>
  <info>Note: this demo opens the member for display; editing is not saved.</info>

  <botinst>Enter a member name, or PF3 to return to the Primary Option Menu.</botinst>

  <keyl name="EDITKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>

<!DOCTYPE DM SYSTEM>
<!-- ISPF View - Entry Panel (option 1). Prompts for a panel-library member
     name; the server (server._show_view) reads the `member` field, and if it
     names a real panels/*.dtl member opens the Browse panel on its source.
     An unknown member is reported via &VIEWMSG. PF3 returns to the menu.
     Auto-flow (ISPDTLC-idiomatic): no row/col/fldcol; the entry field follows
     its prompt and the cursor starts there via <panel cursor=member>. -->
<panel name="viewentry" help="ispfhelp" cursor="member">View - Entry Panel
  <topinst>Enter the name of a panel library (ISPPLIB) member to browse.</topinst>

  <dtafld datavar="member" entwidth="8">Member name ===></dtafld>

  <info intensity="high">&VIEWMSG</info>
  <info>Tip: option 3.1 (Utilities -> Library) lists the members.</info>

  <botinst>Enter a member name, or PF3 to return to the Primary Option Menu.</botinst>

  <keyl name="VIEWKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>

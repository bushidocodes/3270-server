<!DOCTYPE DM SYSTEM>
<!-- ISPF View - Entry Panel (option 1). Prompts for a panel-library member
     name; the server (server._show_view) reads the `member` field, and if it
     names a real panels/*.dtl member opens the Browse panel on its source.
     An unknown member is reported via &VIEWMSG. PF3 returns to the menu. -->
<panel name="viewentry" title="View - Entry Panel" help="ispfhelp">
  <info row="0" col="0" intensity="high">------------------------------ View - Entry Panel ------------------------------</info>
  <topinst row="2" col="1">Enter the name of a panel library (ISPPLIB) member to browse.</topinst>

  <dtafld row="4" col="1" fldcol="18" datavar="member" entwidth="8" cursor="yes">Member name ===></dtafld>

  <info row="7" col="1" intensity="high">&VIEWMSG</info>
  <info row="9" col="1">Tip: option 3.1 (Utilities -> Library) lists the members.</info>

  <info row="22" col="1">Enter a member name, or PF3 to return to the Primary Option Menu.</info>
  <info row="23" col="0" intensity="high" fill="-" width="79"/>

  <keyl name="VIEWKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>

<!DOCTYPE DM SYSTEM>
<!-- ISPF Command Shell (option 6) -- enter a TSO command.
     The command line is a <cmdarea> (datavar ZCMD); the server reads it with
     Screen.command_value(), runs it (server._run_tso_command), and feeds the
     response back as &CMDMSG for the next display. PF3 returns to the menu;
     Enter runs the typed command and stays (an empty command just clears).
     Auto-flow (ISPDTLC-idiomatic): no row/col/fldcol; the command line follows
     its prompt and the cursor starts there via <panel cursor=ZCMD>. -->
<panel name="cmdshell" help="ispfhelp" cursor="ZCMD">ISPF Command Shell
  <topinst>Enter a TSO command and press Enter; its response appears below.</topinst>

  <cmdarea entwidth="62">Command ===></cmdarea>

  <info intensity="high">&CMDMSG</info>

  <botinst>Enter a command, or PF3 to return to the Primary Option Menu.</botinst>

  <keyl name="CMDKEYS">
    <keyi key="PF1" cmd="HELP">Help</keyi>
    <keyi key="PF3" cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>

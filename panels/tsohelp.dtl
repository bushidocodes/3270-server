<!DOCTYPE DM SYSTEM>
<!-- Help panel for the TSO/E LOGON panel. Shown when the user presses PF1
     (the logon keylist binds PF1 to HELP). PF3 returns to the logon panel.
     Auto-flow (ISPDTLC-idiomatic): no row/col; the title centres itself, the
     conversion utility spaces the blocks, and the field list is a <dl>. -->
<panel name="tsohelp">TSO/E LOGON - HELP
  <info>
    <p>The TSO/E LOGON panel signs you on to TSO under the z/OS system.</p>

    <p><hp>Fields:</hp></p>
    <dl tsize="10">
      <dt>Userid<dd>Your RACF user identifier (1-8 characters).
      <dt>Password<dd>Your RACF password. It is not displayed as you type.
      <dt>Procedure<dd>The logon procedure to invoke (default IKJACCNT).
      <dt>Size<dd>Region size in kilobytes (numeric).
      <dt>Command<dd>An optional command to run immediately at logon.
    </dl>

    <p>Type your userid and password, then press ENTER to log on.</p>

    <p><hp>Demo users: IBMUSER / SYS1 and TESTUSER / RACF.</hp></p>
  </info>

  <botinst>PF3=Return</botinst>

  <keyl name="HELPKEYS">
    <keyi key="PF3"  cmd="EXIT">Return</keyi>
    <keyi key="PF15" cmd="EXIT">Return</keyi>
  </keyl>
</panel>
